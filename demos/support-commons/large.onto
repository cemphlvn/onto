# Support Commons, large: 40 ticket intents in one choice frame, grouped by team.
# `frame Ticket: choice grouped by ByTeam` makes the judge choose a team first (7
# options), then an intent within that team's fiber. Remove `grouped by ByTeam` for
# the flat 40-option choice; `README.md` compares the two, live.

category SupportLarge {
    objects: Ticket, Refund, DoubleCharge, InvoiceRequest, PaymentFailed, UpdatePaymentMethod, PricingQuestion, CancelSubscription, Outage, SlowPerformance, ErrorMessage, DataSync, AppCrash, IntegrationBroken, HowToUse, LoginProblem, PasswordReset, TwoFactor, DeleteAccount, ChangeEmail, AccountLocked, WhereIsOrder, DeliveredNotReceived, DamagedItem, WrongItem, ChangeAddress, ReturnItem, FeatureRequest, IntegrationRequest, BugReportUi, Accessibility, RoadmapQuestion, PhishingReport, SuspiciousLogin, DataBreachConcern, VulnerabilityReport, AccountTakeover, DataExportRequest, PrivacyComplaint, LegalNotice, TermsQuestion;
    about Ticket: "a message a customer sent to support";
    frame Ticket: choice grouped by ByTeam "Which kind of ticket is this?";
    refund: Ticket -> Refund "the customer wants money back for a charge";
    double_charge: Ticket -> DoubleCharge "the customer was charged twice for the same thing";
    invoice_request: Ticket -> InvoiceRequest "the customer needs an invoice, receipt or VAT document";
    payment_failed: Ticket -> PaymentFailed "a payment or renewal was declined or failed";
    update_payment_method: Ticket -> UpdatePaymentMethod "the customer wants to change the card or payment method on file";
    pricing_question: Ticket -> PricingQuestion "a question about what something costs";
    cancel_subscription: Ticket -> CancelSubscription "the customer wants to stop a paid subscription";
    outage: Ticket -> Outage "the service is down or unavailable";
    slow_performance: Ticket -> SlowPerformance "the product works but is slow";
    error_message: Ticket -> ErrorMessage "an action fails with an error message";
    data_sync: Ticket -> DataSync "data is missing or out of sync between devices";
    app_crash: Ticket -> AppCrash "a mobile or desktop app closes or crashes";
    integration_broken: Ticket -> IntegrationBroken "an existing integration with another product stopped working";
    how_to_use: Ticket -> HowToUse "how to do something the product already supports";
    login_problem: Ticket -> LoginProblem "cannot sign in although the credentials seem right";
    password_reset: Ticket -> PasswordReset "wants to reset or change a password";
    two_factor: Ticket -> TwoFactor "trouble with two-factor codes or the authenticator device";
    delete_account: Ticket -> DeleteAccount "wants to close their account";
    change_email: Ticket -> ChangeEmail "wants to change the email address of the account";
    account_locked: Ticket -> AccountLocked "the account is locked or suspended";
    where_is_order: Ticket -> WhereIsOrder "asks where an order is or when it will arrive";
    delivered_not_received: Ticket -> DeliveredNotReceived "marked delivered but not received";
    damaged_item: Ticket -> DamagedItem "an item arrived damaged";
    wrong_item: Ticket -> WrongItem "a different item than ordered arrived";
    change_address: Ticket -> ChangeAddress "wants to change the delivery address of an order";
    return_item: Ticket -> ReturnItem "wants to send an item back";
    feature_request: Ticket -> FeatureRequest "asks for a capability the product does not have";
    integration_request: Ticket -> IntegrationRequest "asks for an integration with another product that does not exist yet";
    bug_report_ui: Ticket -> BugReportUi "reports a visual or layout problem in the interface";
    accessibility: Ticket -> Accessibility "reports a problem using the product with assistive technology";
    roadmap_question: Ticket -> RoadmapQuestion "asks what is planned for the product";
    phishing_report: Ticket -> PhishingReport "reports a message pretending to come from the company";
    suspicious_login: Ticket -> SuspiciousLogin "reports sign-in activity they do not recognize";
    data_breach_concern: Ticket -> DataBreachConcern "worries that their data was leaked";
    vulnerability_report: Ticket -> VulnerabilityReport "reports a security weakness in the product";
    account_takeover: Ticket -> AccountTakeover "says someone else has taken over their account";
    data_export_request: Ticket -> DataExportRequest "asks for a copy of the personal data held about them";
    privacy_complaint: Ticket -> PrivacyComplaint "complains about how their personal data is used";
    legal_notice: Ticket -> LegalNotice "sends or announces a formal legal notice";
    terms_question: Ticket -> TermsQuestion "asks about the terms of service or a contract clause";
    closed: Ticket, Refund, DoubleCharge, InvoiceRequest, PaymentFailed, UpdatePaymentMethod, PricingQuestion, CancelSubscription, Outage, SlowPerformance, ErrorMessage, DataSync, AppCrash, IntegrationBroken, HowToUse, LoginProblem, PasswordReset, TwoFactor, DeleteAccount, ChangeEmail, AccountLocked, WhereIsOrder, DeliveredNotReceived, DamagedItem, WrongItem, ChangeAddress, ReturnItem, FeatureRequest, IntegrationRequest, BugReportUi, Accessibility, RoadmapQuestion, PhishingReport, SuspiciousLogin, DataBreachConcern, VulnerabilityReport, AccountTakeover, DataExportRequest, PrivacyComplaint, LegalNotice, TermsQuestion;
}

category Teams {
    objects: Inbox, Billing, Technical, Account, Shipping, Product, Security, Legal;
    frame Inbox: choice "Which team should handle this ticket?";
    billing: Inbox -> Billing "money: charges, refunds, invoices, payments, prices, subscriptions";
    technical: Inbox -> Technical "the product misbehaves or someone needs help using it";
    account: Inbox -> Account "access and identity: signing in, passwords, two-factor, account settings";
    shipping: Inbox -> Shipping "physical orders: delivery, damage, wrong items, returns";
    product: Inbox -> Product "requests and feedback about what the product does";
    security: Inbox -> Security "threats: phishing, unrecognized access, leaks, vulnerabilities";
    legal: Inbox -> Legal "personal-data rights, complaints, legal notices and terms";
    closed: Inbox;
}

functor ByTeam: SupportLarge -> Teams {
    objects: Ticket -> Inbox, Refund -> Billing, DoubleCharge -> Billing, InvoiceRequest -> Billing, PaymentFailed -> Billing, UpdatePaymentMethod -> Billing, PricingQuestion -> Billing, CancelSubscription -> Billing, Outage -> Technical, SlowPerformance -> Technical, ErrorMessage -> Technical, DataSync -> Technical, AppCrash -> Technical, IntegrationBroken -> Technical, HowToUse -> Technical, LoginProblem -> Account, PasswordReset -> Account, TwoFactor -> Account, DeleteAccount -> Account, ChangeEmail -> Account, AccountLocked -> Account, WhereIsOrder -> Shipping, DeliveredNotReceived -> Shipping, DamagedItem -> Shipping, WrongItem -> Shipping, ChangeAddress -> Shipping, ReturnItem -> Shipping, FeatureRequest -> Product, IntegrationRequest -> Product, BugReportUi -> Product, Accessibility -> Product, RoadmapQuestion -> Product, PhishingReport -> Security, SuspiciousLogin -> Security, DataBreachConcern -> Security, VulnerabilityReport -> Security, AccountTakeover -> Security, DataExportRequest -> Legal, PrivacyComplaint -> Legal, LegalNotice -> Legal, TermsQuestion -> Legal;
    refund: billing; double_charge: billing; invoice_request: billing; payment_failed: billing; update_payment_method: billing; pricing_question: billing; cancel_subscription: billing;
    outage: technical; slow_performance: technical; error_message: technical; data_sync: technical; app_crash: technical; integration_broken: technical; how_to_use: technical;
    login_problem: account; password_reset: account; two_factor: account; delete_account: account; change_email: account; account_locked: account;
    where_is_order: shipping; delivered_not_received: shipping; damaged_item: shipping; wrong_item: shipping; change_address: shipping; return_item: shipping;
    feature_request: product; integration_request: product; bug_report_ui: product; accessibility: product; roadmap_question: product;
    phishing_report: security; suspicious_login: security; data_breach_concern: security; vulnerability_report: security; account_takeover: security;
    data_export_request: legal; privacy_complaint: legal; legal_notice: legal; terms_question: legal;
}
