// copied from the OSIL draft (oaas conformance corpus 030, another session, 2026-10-30, not yet in a repo); the source of truth for flow.onto
// provenance: onto's architecture pipeline (demos/thin-agent, 2026-10-30)
// as a flow: onto proposes an architecture mapping, the substrate gates
// and checks it, and the verdict closes the CI loop.
use domain.thinagent

input sources : Files<java>[N]
input blueprint : Blueprint<osil>[1]
input standard : Category<onto>[1]
const calibration : Map<platt>[1]
const cost : Cost<ratio>[1]
output decision : Verdict<bool_>[1]
output view : Image<svg>[1]
output record : Record<frame>[1]

sources -> thinagent::DeriveDeps@0 -> deps
blueprint, deps -> thinagent::Discover@0 -> proposal
proposal, calibration -> thinagent::Calibrate@0 -> scored
scored, cost -> thinagent::Gate@0 -> (accepted, deferred)
deferred -> thinagent::AskHuman@0 -> answers
accepted, answers -> thinagent::Adopt@0 -> roles
roles, deps, standard -> thinagent::FunctorCheck@0 -> verdict
verdict -> thinagent::Record@0 -> record
verdict -> thinagent::CIGate@0 -> decision
roles, deps -> thinagent::RenderView@0 -> view

layout {
    node sources [0, 0, 130, 40]
    node blueprint [0, 96, 130, 40]
    node standard [0, 320, 130, 40]
    node calibration [180, 200, 130, 40]
    node cost [360, 200, 130, 40]
    node deps [180, 0, 130, 40]
    node proposal [180, 96, 130, 40]
    node scored [360, 96, 130, 40]
    node accepted [540, 64, 130, 40]
    node deferred [540, 144, 130, 40]
    node answers [720, 144, 130, 40]
    node roles [720, 64, 130, 40]
    node verdict [900, 160, 130, 40]
    node record [1080, 112, 130, 40]
    node decision [1080, 208, 130, 40]
    node view [1080, 16, 130, 40]
    edge sources -> deps waypoints [(130,20) (180,20)]
    edge blueprint -> proposal waypoints [(130,116) (180,116)]
    edge deps -> proposal waypoints [(245,40) (245,96)]
    edge proposal -> scored waypoints [(310,116) (360,116)]
    edge calibration -> scored waypoints [(310,220) (335,220) (335,124) (360,124)]
    edge scored -> accepted waypoints [(490,108) (515,108) (515,84) (540,84)]
    edge cost -> accepted waypoints [(490,220) (515,220) (515,84) (540,84)]
    edge scored -> deferred waypoints [(490,124) (515,124) (515,164) (540,164)]
    edge deferred -> answers waypoints [(670,164) (720,164)]
    edge accepted -> roles waypoints [(670,84) (720,84)]
    edge answers -> roles waypoints [(785,144) (785,104)]
    edge roles -> verdict waypoints [(850,84) (875,84) (875,172) (900,172)]
    edge deps -> verdict waypoints [(310,12) (875,12) (875,172) (900,172)]
    edge standard -> verdict waypoints [(130,340) (875,340) (875,188) (900,188)]
    edge verdict -> record waypoints [(1030,172) (1055,172) (1055,132) (1080,132)]
    edge verdict -> decision waypoints [(1030,188) (1055,188) (1055,228) (1080,228)]
    edge roles -> view waypoints [(850,72) (1055,72) (1055,36) (1080,36)]
    viewport [0, -16, 1.0]
}
