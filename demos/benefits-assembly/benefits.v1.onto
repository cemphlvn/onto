# Version 1 of the benefits policy (before 2026-09-24), kept for the Upgrade functor
# in versions.onto. The live policy is benefits.onto (version 2).
# Benefits Assembly: one coordinated application instead of separate
# programs, each asking for the same evidence in a different way.
#
# 1. The application splits (no judgment) into four lines: income,
#    residency and household evidence, which every application needs, and
#    the person's circumstances, where the judge decides whether a special
#    circumstance (disability) applies.
# 2. Each line is complete only on evidence attested by the institution
#    that holds it (tax authority, civil registry, medical board).
#    `join EvidenceComplete: all` waits for every line; a missing line makes
#    the join incomplete and names it.
# 3. With the evidence complete, the application is prepared while the
#    benefits office decides eligibility, in parallel; a gate lets the
#    submission through only with the office's attested approval, which
#    grants EligibilityGrant. Submitted needs that capability on entry.

category BenefitsAssemblyV1 {
    attester TaxAuthority   { key: ed25519:xMmHhpe4zfogt2tMU8ope1VHLE+v4u0Mdol9R/nXvgE=;   observes: income.below_threshold; }
    attester CivilRegistry  { key: ed25519:E58e3uS804ciLMtKTR4hB1QCCqiwsxHy+IDU9lKkvS0=;  observes: residency.confirmed, household.confirmed; }
    attester MedicalBoard   { key: ed25519:tAyfkTYsCXxujznVptAyu8alToL6/G58QSp+JoflUI0=;   observes: disability.assessed; }
    attester BenefitsOffice { key: ed25519:9vJ4514yJL8R7nRgmAF6vewQTr3WaFdla+R4/jddtks=; observes: eligibility.approved; }

    capability EligibilityGrant { issuers: approved; }

    objects: Application, Income, Residency, Household, Circumstances, Disability,
             EvidenceComplete, Preparation, Decision, Ready, Submitted;
    start: Application;

    # What models see (policy). The only judged frame reads the person's
    # own statement and, as precedents, earlier decisions at this frame
    # (projected onto the same field). Nothing from the applicant record
    # (name, birth date, nationality, ethnicity, gender, postcode) reaches
    # any model: proved on load and for every proposal.
    state Circumstances { case: statement; memory: similar 3; }
    state { case: statement; }
    invariant unseen: case.applicant;

    # New kinds of circumstance may be learned (they need a person); the
    # evidence lines, joins and submission are sealed.
    world: closed;
    learnable: Circumstances;

    about Application: "a person asks for support; their situation may span several programs";
    about Submitted: "one coordinated application is submitted for the person";

    # Every application needs these lines; no model decides which apply.
    frame Application: split;
    income_line:        Application -> Income;
    residency_line:     Application -> Residency;
    household_line:     Application -> Household;
    circumstances_line: Application -> Circumstances;
    closed: Application;

    frame Income: split;
    income_evidenced:    Income -> EvidenceComplete "income is below the program threshold"
                         attested income.below_threshold == true;
    frame Residency: split;
    residency_evidenced: Residency -> EvidenceComplete "residency is confirmed"
                         attested residency.confirmed == true;
    frame Household: split;
    household_evidenced: Household -> EvidenceComplete "household composition is confirmed"
                         attested household.confirmed == true;

    # The judged part: does a special circumstance apply to this person?
    frame Circumstances: choice "Does the person describe a disability or long-term health condition that affects their support?";
    has_disability: Circumstances -> Disability "the person describes a disability or long-term health condition";
    none_apply:     Circumstances -> EvidenceComplete "no disability or long-term health condition is described";
    frame Disability: split;
    disability_evidenced: Disability -> EvidenceComplete "the disability has been assessed"
                          attested disability.assessed == true;
    closed: Income, Residency, Household, Circumstances, Disability;
    join EvidenceComplete: all;

    # Prepare the application while the office decides eligibility.
    frame EvidenceComplete: split;
    prepare:         EvidenceComplete -> Preparation;
    request_decision: EvidenceComplete -> Decision;
    closed: EvidenceComplete;

    frame Preparation: split;
    prepared: Preparation -> Ready "assemble one application from the evidence";
    frame Decision: split;
    approved: Decision -> Ready "the benefits office approves eligibility"
              attested eligibility.approved == true ensures EligibilityGrant;
    closed: Preparation, Decision;
    join Ready: gate authority request_decision export EligibilityGrant;

    frame Ready: split;
    submit: Ready -> Submitted "submit the coordinated application";
    entry Submitted: needs EligibilityGrant;
    closed: Ready, Submitted;
}
