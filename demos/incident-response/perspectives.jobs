# One case per line. Each column sees only its own field (its `state`):
# metrics, logs or complaints. The goal is the same for every column.
# P-1: a bad deploy, seen by all three perspectives: agreement.
Outage: {"id": "P-1", "goal": "Assess the shop's condition from your signals, 14:05 UTC", "metrics": {"http_5xx_rate": "6.8% (usual 0.2%)", "p95_latency_ms": 410, "p95_latency_usual_ms": 380, "cpu": "41%", "db_connections": "38/200"}, "logs": ["14:01:12 deploy web@8f3c2a started", "14:01:55 deploy web@8f3c2a finished", "14:02:03 ERROR TypeError: cannot read properties of undefined (reading 'currency') at CartTotals.render", "14:02:03 ERROR 500 POST /checkout/confirm", "14:02:04 ERROR 500 POST /checkout/confirm (x412 in 3 min)"], "complaints": ["I get an error page when I click Pay", "Checkout fails every time, tried three cards", "order won't go through, just 'something went wrong'"]}
# P-2: a monitoring blind spot. Metrics and logs look healthy (the identity
# provider fails on its own side and the app never sees the requests), but
# customers cannot sign in: a surprise.
Outage: {"id": "P-2", "goal": "Assess the shop's condition from your signals, 09:40 UTC", "metrics": {"http_5xx_rate": "0.2% (usual 0.2%)", "p95_latency_ms": 360, "p95_latency_usual_ms": 380, "cpu": "35%", "db_connections": "30/200", "requests_per_min": "11.9k (usual 12.4k)"}, "logs": ["09:31:40 INFO GET /products 200", "09:35:02 INFO POST /cart 200", "09:38:17 INFO GET /account/orders 200", "no ERROR or WARN entries in the last 30 minutes"], "complaints": ["I can't log in, the sign-in page just spins", "Login with Google redirects me back to the start", "Can't access my account since this morning"]}
# P-3: competing causes. Metrics point at capacity, logs at the database;
# both are plausible and IncidentState has them as different branches.
Outage: {"id": "P-3", "goal": "Assess the shop's condition from your signals, 20:15 UTC", "metrics": {"http_5xx_rate": "1.1% (usual 0.2%)", "p95_latency_ms": 4200, "p95_latency_usual_ms": 380, "cpu": "97% on all 6 web nodes", "requests_per_min": "41k (usual 12k, campaign email sent 20:00)", "autoscaling": "at max (6/6)"}, "logs": ["20:09:44 ERROR sqlalchemy: QueuePool limit of size 20 overflow 10 reached, connection timed out", "20:09:45 ERROR could not obtain database connection within 30s", "20:10:02 WARN slow query 8.2s SELECT ... FROM orders"], "complaints": ["The site is so slow it's unusable", "pages take forever to load during the sale", "timed out twice trying to view the sale items"]}
# P-4: a quiet evening: every perspective sees a healthy shop.
Outage: {"id": "P-4", "goal": "Assess the shop's condition from your signals, 23:30 UTC", "metrics": {"http_5xx_rate": "0.1% (usual 0.2%)", "p95_latency_ms": 350, "p95_latency_usual_ms": 380, "cpu": "22%", "db_connections": "12/200"}, "logs": ["23:21:08 INFO GET /products 200", "23:24:51 INFO POST /checkout/confirm 200", "no ERROR entries in the last 30 minutes"], "complaints": []}
