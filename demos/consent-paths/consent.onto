# Consent Paths: where personal data may go, and on what authority.
# Each arrow is a processing step; its description names the legal basis.
# `require` clauses are checked in code against the case's facts before
# any model is asked: evidence, not judgment. A data use is authorized only
# if a path reaches it. Equations record routes that end in the same state.
#
# Capabilities: a legal basis is a checked fact that grants a token
# (`ensures`); objects state what every walk entering them must hold
# (`entry … needs`). The rules live on the objects, so every arrow into
# them, including arrows added later, inherits them. `onto laws` derives
# what follows.

category Consent {
    objects: Collected, Consented, Contract, Pseudonymized, Anonymized,
             Aggregated, Research, Processor, Marketing, Published;

    about Collected: "personal data the organization holds about a person";
    about Research:   "the data is used in a scientific or academic study";
    about Processor:  "the data is held by an external processor acting for the organization";
    about Published:  "aggregate statistics are made public";
    about Marketing:  "the person receives marketing";

    frame Collected: choice "On which legal basis would this intended use rest?";
    consent:  Collected -> Consented "the person explicitly agreed to this kind of use (GDPR 6(1)(a))"
              require consent.given == true ensures ConsentGrant, LegalBasis;
    contract: Collected -> Contract  "the use is necessary to deliver the service the person signed up for (GDPR 6(1)(b))"
              require contract.active == true ensures LegalBasis;
    closed: Collected;                      # the only two bases this organization relies on
    start: Collected;                       # where this application's walks begin

    pseudonymize: Consented -> Pseudonymized "remove direct identifiers before further use: analytics, research, sharing";
    market:       Consented -> Marketing "send marketing to the person";
    withdraw:     Consented -> Collected "the person withdraws their consent"
                  revokes ConsentGrant, LegalBasis;
    closed: Consented;

    # Capabilities: only these arrows may issue or revoke each token.
    capability ConsentGrant { issuers: consent; revokers: withdraw; }
    capability LegalBasis   { issuers: consent, contract; revokers: withdraw; }

    # Entry contracts: stated once, inherited by every arrow in.
    entry Pseudonymized: needs LegalBasis;
    entry Marketing: needs ConsentGrant require consent.marketing == true;

    fulfil_pseudonymize: Contract -> Pseudonymized "pseudonymize data used to deliver the contracted service";
    # Contract stays open: other contract-necessary uses are not enumerated.

    anonymize:    Pseudonymized -> Anonymized "irreversibly remove identity so the data no longer relates to a person";
    research_use: Pseudonymized -> Research   "scientific or academic research with safeguards (GDPR 89)";
    # Parallel arrows: same endpoints, different legal basis, told apart by evidence.
    share_dpa: Pseudonymized -> Processor "give data to a processor in the EU under a data processing agreement (GDPR 28)"
               require processor.region == "EU";
    share_scc: Pseudonymized -> Processor "give data to a processor outside the EU under standard contractual clauses (GDPR 46)"
               require processor.region != "EU" and processor.scc == true;
    closed: Pseudonymized;

    aggregate: Anonymized -> Aggregated "combine records into statistics";
    closed: Anonymized;

    publish: Aggregated -> Published "publish the statistics";
    closed: Aggregated;

    closed: Research, Processor, Marketing, Published;

    # Invariants: what no extension of this graph may break (checked by
    # `onto review` on every proposal; via/never are proved, rules judged).
    invariant via: Collected -> Marketing through Consented;       # marketing only with consent
    invariant via: Collected -> Processor through Pseudonymized;   # processors never get raw data
    invariant never: Collected -> Advertiser;                      # data is never sold to advertisers
    invariant via: Collected -> Pseudonymized through Consented | Contract;   # every use rests on a legal basis
    invariant via: Collected -> Research through Consented | Contract;
    invariant via: Collected -> Aggregated through Consented | Contract;
    invariant rule "This organization relies only on explicit consent (GDPR 6(1)(a)) and contract (GDPR 6(1)(b)). No arrow may introduce any other legal basis, such as legitimate interest or legal obligation.";

    # Pseudonymizing under either basis leads to the same anonymized state.
    anonymize.pseudonymize.consent = anonymize.fulfil_pseudonymize.contract;
}
